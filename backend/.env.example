# Copy to your deployment environment (do not commit a real .env file).

# Comma-separated browser origins allowed to call the API. Set this in production.
SMP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SMP_MAX_BODY_BYTES=8192
SMP_MAX_EXPRESSION_LENGTH=300
SMP_COMPUTE_TIMEOUT_SECONDS=6
SMP_RATE_LIMIT_PER_MINUTE=30

# Serve the built SPA from this directory (single-origin deployment).

SMP_FRONTEND_DIST=

# Hide /api/docs and /api/openapi.json when false.
SMP_ENABLE_DOCS=true
SMP_LOG_LEVEL=info
